      "link": null,
      "locked": false,
      "text": "initialize main \n\nAPI\ncreate/branch/<from>\nbranch/diff/from..to - compare the staged changes\nbranch/validate\nbranch/commit (staged changes) \n    - generate snapshot\n    - apply changes to DB \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "initialize main \n\nAPI\ncreate/branch/<from>\nbranch/diff/from..to - compare the staged changes\nbranch/validate\nbranch/commit (staged changes) \n    - generate snapshot\n    - apply changes to DB \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "boundElements": null,
      "updated": 1784091691543,
      "link": null,
      "locked": false,
      "text": "\nRider\n--------------\nHeader\nuser\n/getEstimate{\n    source\ndestination\n} -> Ride[]\n\n/request{\n    source\n    destination\n    ride_type\n} -> Ride /reject\n\n\nDriver\n--------------------\nPUT /drivers/:driverId/location\n\nPATCH /rides/:rideId{\n    accept/deny\n}\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nRider\n--------------\nHeader\nuser\n/getEstimate{\n    source\ndestination\n} -> Ride[]\n\n/request{\n    source\n    destination\n    ride_type\n} -> Ride /reject\n\n\nDriver\n--------------------\nPUT /drivers/:driverId/location\n\nPATCH /rides/:rideId{\n    accept/deny\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

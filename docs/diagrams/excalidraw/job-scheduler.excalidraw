    {
      "id": "wQnOorinF6LM5b0clmLSn",
      "type": "text",
      "x": -87.9154052734375,
      "y": 724.25,
      "width": 373.18359375,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

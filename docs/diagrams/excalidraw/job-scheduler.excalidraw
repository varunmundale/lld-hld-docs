      "seed": 1091165032,
      "version": 353,
      "versionNonce": 1622729064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786896464294,
      "link": null,
      "locked": false,
      "text": "Functional requirements\n- create jobs  (scheduled)\n- Define dependency for jobs (during creation)\n- Execute based on dependency\n- When job finishes notify\n\n\nNFR\n- Concurrency\n- Highly available  + fault tolerant\n- At-least once semantics\n- Latency < 15 mins\n\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements\n- create jobs  (scheduled)\n- Define dependency for jobs (during creation)\n- Execute based on dependency\n- When job finishes notify\n\n\nNFR\n- Concurrency\n- Highly available  + fault tolerant\n- At-least once semantics\n- Latency < 15 mins\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
